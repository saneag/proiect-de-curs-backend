{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "rootDir": "src/generated",
    "outDir": "build/generated"
  },
  "include": [
    "src/generated/**/*.ts"
  ]
}
