{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.ts",
    "scripts": {
        "start": "nodemon src/index.ts",
        "build": "node -e \"require('fs').rmSync('./build',{recursive:true,force:true})\" && prisma generate && tsc",
        "copy-uploads": "node -e \"require('fs').cpSync('./src/uploads','./build/uploads',{recursive:true})\"",
        "prod": "npm run build && npm run copy-uploads && node build/index.js",
        "test": "npm run build && node --test tests/integrity.test.cjs",
        "prisma:validate": "prisma validate",
        "prisma:generate": "prisma generate && tsc -p tsconfig.prisma.json",
        "db:migrate": "prisma migrate deploy",
        "backup:convert": "node scripts/convert-backups.cjs",
        "backup:import": "node scripts/import-backups.cjs",
        "test:backup": "node --test tests/backup-conversion.test.cjs",
        "test:backup:integration": "npm run prisma:generate && node --test tests/backup-import.test.cjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.5",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.5.0",
        "nodemon": "^3.1.14",
        "sanitize-html": "^2.18.2"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.11",
        "@types/sanitize-html": "^2.16.2",
        "embedded-postgres": "^18.7.0-beta.19",
        "prisma": "^7.10.1",
        "ts-node": "^10.9.2",
        "typescript": "~5.9"
    }
}
