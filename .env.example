PORT=5000
FRONTEND_ORIGIN=http://localhost:8082
JWTSECRET=
JWTREFRESHSECRET=

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=friendo_app
