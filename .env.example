PORT=5000
FRONTEND_ORIGIN=http://localhost:8082
JWTSECRET=
JWTREFRESHSECRET=
POSTGRES_USER=friendo_app
POSTGRES_PASSWORD=
POSTGRES_DB=friendo
# Compose uses the private postgres service name. URL-encode the password here.
DATABASE_URL=postgresql://friendo_app:SET_POSTGRES_PASSWORD@postgres:5432/friendo
# For a host-run API, use 127.0.0.1 and your local PostgreSQL port instead.
